{
  "expo": {
    "name": "Dhyaan",
    "slug": "dhyaan",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./dhyaan_ios_icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAEEDA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./dhyaan_ios_icon.png",
      "bundleIdentifier": "com.santosh.dhyaan"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAEEDA"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c6ce8af8-90d8-479a-affa-afc3dbcdd1fc"
      }
    }
  }
}
